{
 "name": "Grounded cold outreach",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 9 * * 1-5"
      }
     ]
    }
   },
   "id": "grounded-cold-outreach-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "operation": "getAll",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "grounded-cold-outreach-1",
   "name": "Get new leads",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "batchSize": 1
   },
   "id": "grounded-cold-outreach-2",
   "name": "Each lead",
   "type": "n8n-nodes-base.splitInBatches",
   "typeVersion": 3,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "={{$json.website}}"
   },
   "id": "grounded-cold-outreach-3",
   "name": "Fetch site",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const t=String($json.data||'').replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>|<[^>]+>/g,' ').replace(/\\s+/g,' ').trim();return [{json:{text:t.slice(0,3000),thin:t.length<300}}];"
   },
   "id": "grounded-cold-outreach-4",
   "name": "Extract text",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{!$json.thin}}",
       "value2": true
      }
     ]
    }
   },
   "id": "grounded-cold-outreach-5",
   "name": "Enough text?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Write a 90-word cold email using ONLY facts in the page text. No invented claims.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{$json.text}}\"}]}"
   },
   "id": "grounded-cold-outreach-6",
   "name": "Write draft",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1560,
    0
   ]
  },
  {
   "parameters": {
    "operation": "append",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "grounded-cold-outreach-7",
   "name": "Save draft",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    1820,
    0
   ]
  },
  {
   "parameters": {
    "operation": "append",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "grounded-cold-outreach-8",
   "name": "Flag for review",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    1560,
    200
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Outreach drafts ready for review."
   },
   "id": "grounded-cold-outreach-9",
   "name": "Batch done",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    780,
    200
   ]
  },
  {
   "parameters": {},
   "id": "grounded-cold-outreach-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "grounded-cold-outreach-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Grounded cold outreach\nLoops over your leads one by one, reads each real website, and drafts an email using only what is on the page. Thin sites go to a human.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** If a page has under 300 characters of text, no draft is written and the lead is flagged. Nothing is sent.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "grounded-cold-outreach-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
