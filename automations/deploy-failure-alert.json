{
 "name": "Deploy failure alert",
 "nodes": [
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "deploy-status",
    "responseMode": "onReceived"
   },
   "id": "deploy-failure-alert-0",
   "name": "Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.body.status==='failed'}}",
       "value2": true
      }
     ]
    }
   },
   "id": "deploy-failure-alert-1",
   "name": "Failed?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const b=$json.body;const log=String(b.log||'').replace(/(token|secret|key)[=:]\\s*\\S+/gi,'$1=[hidden]').slice(-800);return [{json:{app:b.app,url:b.url,log}}];"
   },
   "id": "deploy-failure-alert-2",
   "name": "Clean log",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Deploy failed: {{$json.app}}\n{{$json.url}}\n{{$json.log}}"
   },
   "id": "deploy-failure-alert-3",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "REPLACE_ME_ISSUES_API"
   },
   "id": "deploy-failure-alert-4",
   "name": "Open tracking issue",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    200
   ]
  },
  {
   "parameters": {},
   "id": "deploy-failure-alert-5",
   "name": "Count success",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    520,
    200
   ]
  },
  {
   "parameters": {},
   "id": "deploy-failure-alert-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "deploy-failure-alert-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Deploy failure alert\nReceives a deploy webhook. On failure it cleans the log, then alerts you and opens a tracking issue at the same time.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Strips tokens and long logs first. Successful deploys are only counted.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "deploy-failure-alert-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Webhook": {
   "main": [
    [
     {
      "node": "Failed?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Failed?": {
   "main": [
    [
     {
      "node": "Clean log",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Count success",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Clean log": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     },
     {
      "node": "Open tracking issue",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
