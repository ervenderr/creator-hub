{
 "name": "Calendar prep brief",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "30 7 * * 1-5"
      }
     ]
    }
   },
   "id": "calendar-prep-brief-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "operation": "getAll",
    "calendar": {
     "__rl": true,
     "mode": "id",
     "value": "primary"
    },
    "returnAll": false,
    "limit": 15
   },
   "id": "calendar-prep-brief-1",
   "name": "Today's events",
   "type": "n8n-nodes-base.googleCalendar",
   "typeVersion": 1.2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "resource": "message",
    "operation": "getAll",
    "returnAll": false,
    "limit": 20
   },
   "id": "calendar-prep-brief-2",
   "name": "Recent mail from attendees",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    260,
    200
   ]
  },
  {
   "parameters": {
    "numberInputs": 2
   },
   "id": "calendar-prep-brief-3",
   "name": "Join",
   "type": "n8n-nodes-base.merge",
   "typeVersion": 3,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"One short prep line per meeting. Use only the given data.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{JSON.stringify($input.all().map(i=>i.json))}}\"}]}"
   },
   "id": "calendar-prep-brief-4",
   "name": "Write prep notes",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Today:\n{{$json.content[0].text}}"
   },
   "id": "calendar-prep-brief-5",
   "name": "Send brief",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {},
   "id": "calendar-prep-brief-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "calendar-prep-brief-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Calendar prep brief\nEach morning, reads today's meetings and recent emails from attendees at the same time, and writes a one-line prep note per meeting.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Uses only your own calendar and mail. Nothing is shared outside your chat.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "calendar-prep-brief-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Today's events",
      "type": "main",
      "index": 0
     },
     {
      "node": "Recent mail from attendees",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Today's events": {
   "main": [
    [
     {
      "node": "Join",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Recent mail from attendees": {
   "main": [
    [
     {
      "node": "Join",
      "type": "main",
      "index": 1
     }
    ]
   ]
  },
  "Join": {
   "main": [
    [
     {
      "node": "Write prep notes",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Write prep notes": {
   "main": [
    [
     {
      "node": "Send brief",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Productivity",
  "description": "Each morning, reads today's meetings and recent emails from attendees at the same time, and writes a one-line prep note per meeting.",
  "guardrails": "Uses only your own calendar and mail. Nothing is shared outside your chat."
 }
}
