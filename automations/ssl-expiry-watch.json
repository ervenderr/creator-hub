{
 "name": "SSL expiry watch",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 6 * * *"
      }
     ]
    }
   },
   "id": "ssl-expiry-watch-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "return ['example.com','docs.example.com','api.example.com'].map(d=>({json:{domain:d}}));"
   },
   "id": "ssl-expiry-watch-1",
   "name": "List domains",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "batchSize": 1
   },
   "id": "ssl-expiry-watch-2",
   "name": "Each domain",
   "type": "n8n-nodes-base.splitInBatches",
   "typeVersion": 3,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "REPLACE_ME_CERT_API"
   },
   "id": "ssl-expiry-watch-3",
   "name": "Check certificate",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const d=Math.floor((new Date($json.expires)-Date.now())/864e5);const s=$getWorkflowStaticData('global');const k=$json.domain;const recent=s[k]&&Date.now()-s[k]<6048e5;if(d<=21&&!recent)s[k]=Date.now();return [{json:{domain:k,days:d,alert:d<=21&&!recent}}];"
   },
   "id": "ssl-expiry-watch-4",
   "name": "Days left",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.alert}}",
       "value2": true
      }
     ]
    }
   },
   "id": "ssl-expiry-watch-5",
   "name": "Alert?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "={{$json.domain}} certificate expires in {{$json.days}} days"
   },
   "id": "ssl-expiry-watch-6",
   "name": "Warn me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1560,
    0
   ]
  },
  {
   "parameters": {},
   "id": "ssl-expiry-watch-7",
   "name": "Fine",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    1560,
    200
   ]
  },
  {
   "parameters": {},
   "id": "ssl-expiry-watch-8",
   "name": "All checked",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    780,
    200
   ]
  },
  {
   "parameters": {},
   "id": "ssl-expiry-watch-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "ssl-expiry-watch-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## SSL expiry watch\nLoops over your domains daily, checks each certificate, and warns 21 days before expiry, at most once a week per domain.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Read-only checks. Repeat alerts are suppressed.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "ssl-expiry-watch-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "List domains",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "List domains": {
   "main": [
    [
     {
      "node": "Each domain",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Each domain": {
   "main": [
    [
     {
      "node": "All checked",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Check certificate",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Check certificate": {
   "main": [
    [
     {
      "node": "Days left",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Days left": {
   "main": [
    [
     {
      "node": "Alert?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Alert?": {
   "main": [
    [
     {
      "node": "Warn me",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Fine",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Warn me": {
   "main": [
    [
     {
      "node": "Each domain",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Fine": {
   "main": [
    [
     {
      "node": "Each domain",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "DevOps",
  "description": "Loops over your domains daily, checks each certificate, and warns 21 days before expiry, at most once a week per domain.",
  "guardrails": "Read-only checks. Repeat alerts are suppressed."
 }
}
