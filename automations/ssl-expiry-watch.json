{
 "name": "SSL expiry watch",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 6 * * *"
      }
     ]
    }
   },
   "id": "ssl-expiry-watch-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "if(!$input.all().length||Object.keys($input.first().json||{}).length===0)throw new Error('Empty input');return $input.all();"
   },
   "id": "ssl-expiry-watch-1",
   "name": "Validate input",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    300
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "https://REPLACE_ME-cert-checker.example.com"
   },
   "id": "ssl-expiry-watch-2",
   "name": "Check cert API",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    520,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const d=Math.floor((new Date($json.expires)-Date.now())/864e5);const s=$getWorkflowStaticData('global');const k=$json.domain;const recent=s[k]&&Date.now()-s[k]<6048e5;if(d<=21&&!recent)s[k]=Date.now();return [{json:{domain:k,days:d,alert:d<=21&&!recent}}];"
   },
   "id": "ssl-expiry-watch-3",
   "name": "Days left",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    780,
    300
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.alert}}",
       "value2": true
      }
     ]
    }
   },
   "id": "ssl-expiry-watch-4",
   "name": "Alert?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "={{$json.domain}} certificate expires in {{$json.days}} days"
   },
   "id": "ssl-expiry-watch-5",
   "name": "Telegram",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1300,
    300
   ]
  },
  {
   "parameters": {},
   "id": "ssl-expiry-watch-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    560
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "ssl-expiry-watch-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    560
   ]
  },
  {
   "parameters": {
    "content": "## SSL expiry watch\nChecks your domains daily and warns 21 days before a certificate expires.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Read-only checks. Alerts once per domain per week.\n\nBad or empty input stops the run and alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "ssl-expiry-watch-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    20
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Validate input",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Validate input": {
   "main": [
    [
     {
      "node": "Check cert API",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Check cert API": {
   "main": [
    [
     {
      "node": "Days left",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Days left": {
   "main": [
    [
     {
      "node": "Alert?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Alert?": {
   "main": [
    [
     {
      "node": "Telegram",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "DevOps",
  "description": "Checks your domains daily and warns 21 days before a certificate expires.",
  "guardrails": "Read-only checks. Alerts once per domain per week."
 }
}
