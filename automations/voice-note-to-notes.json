{
 "name": "Voice note to notes",
 "nodes": [
  {
   "parameters": {
    "updates": [
     "message"
    ]
   },
   "id": "voice-note-to-notes-0",
   "name": "Telegram trigger",
   "type": "n8n-nodes-base.telegramTrigger",
   "typeVersion": 1.1,
   "position": [
    0,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "if(!$input.all().length||Object.keys($input.first().json||{}).length===0)throw new Error('Empty input');return $input.all();"
   },
   "id": "voice-note-to-notes-1",
   "name": "Validate input",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    300
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.message.chat.id==='REPLACE_ME_CHAT_ID'}}",
       "value2": true
      }
     ]
    }
   },
   "id": "voice-note-to-notes-2",
   "name": "My chat?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    520,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "REPLACE_ME_TRANSCRIBE_API"
   },
   "id": "voice-note-to-notes-3",
   "name": "Transcribe",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Summarize and list to-dos. Keep the speaker's words.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{$json.text}}\"}]}"
   },
   "id": "voice-note-to-notes-4",
   "name": "Summarize",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "={{$json.content[0].text}}"
   },
   "id": "voice-note-to-notes-5",
   "name": "Telegram",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1300,
    300
   ]
  },
  {
   "parameters": {},
   "id": "voice-note-to-notes-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    560
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "voice-note-to-notes-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    560
   ]
  },
  {
   "parameters": {
    "content": "## Voice note to notes\nSend a voice note to a Telegram bot and get back a clean summary and to-dos.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Only your own chat id is accepted; messages from anyone else are ignored.\n\nBad or empty input stops the run and alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "voice-note-to-notes-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    20
   ]
  }
 ],
 "connections": {
  "Telegram trigger": {
   "main": [
    [
     {
      "node": "Validate input",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Validate input": {
   "main": [
    [
     {
      "node": "My chat?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "My chat?": {
   "main": [
    [
     {
      "node": "Transcribe",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Transcribe": {
   "main": [
    [
     {
      "node": "Summarize",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Summarize": {
   "main": [
    [
     {
      "node": "Telegram",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Telegram",
  "description": "Send a voice note to a Telegram bot and get back a clean summary and to-dos.",
  "guardrails": "Only your own chat id is accepted; messages from anyone else are ignored."
 }
}
