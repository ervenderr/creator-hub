{
 "name": "Voice note to notes",
 "nodes": [
  {
   "parameters": {
    "updates": [
     "message"
    ]
   },
   "id": "voice-note-to-notes-0",
   "name": "Telegram trigger",
   "type": "n8n-nodes-base.telegramTrigger",
   "typeVersion": 1.1,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.message.chat.id==='REPLACE_ME_CHAT_ID'}}",
       "value2": true
      }
     ]
    }
   },
   "id": "voice-note-to-notes-1",
   "name": "My chat?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {},
   "id": "voice-note-to-notes-2",
   "name": "Ignore stranger",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{!!$json.message.voice}}",
       "value2": true
      }
     ]
    }
   },
   "id": "voice-note-to-notes-3",
   "name": "Is voice?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    520,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "REPLACE_ME_TRANSCRIBE_API"
   },
   "id": "voice-note-to-notes-4",
   "name": "Transcribe",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Summarize and list to-dos. Keep the speaker's words.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{$json.text||$json.message.text}}\"}]}"
   },
   "id": "voice-note-to-notes-5",
   "name": "Summarize",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1040,
    200
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "={{$json.content[0].text}}"
   },
   "id": "voice-note-to-notes-6",
   "name": "Send notes",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1300,
    200
   ]
  },
  {
   "parameters": {},
   "id": "voice-note-to-notes-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "voice-note-to-notes-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Voice note to notes\nAccepts only your own chat. Voice notes are transcribed first, text goes straight to the summary, and you get notes and to-dos back.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Messages from anyone other than your chat id are ignored.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "voice-note-to-notes-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Telegram trigger": {
   "main": [
    [
     {
      "node": "My chat?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "My chat?": {
   "main": [
    [
     {
      "node": "Is voice?",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Ignore stranger",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Is voice?": {
   "main": [
    [
     {
      "node": "Transcribe",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Summarize",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Transcribe": {
   "main": [
    [
     {
      "node": "Summarize",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Summarize": {
   "main": [
    [
     {
      "node": "Send notes",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Telegram",
  "description": "Accepts only your own chat. Voice notes are transcribed first, text goes straight to the summary, and you get notes and to-dos back.",
  "guardrails": "Messages from anyone other than your chat id are ignored."
 }
}
