{
 "name": "Uptime watch",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "*/5 * * * *"
      }
     ]
    }
   },
   "id": "uptime-watch-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "if(!$input.all().length||Object.keys($input.first().json||{}).length===0)throw new Error('Empty input');return $input.all();"
   },
   "id": "uptime-watch-1",
   "name": "Validate input",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    300
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "https://REPLACE_ME.example.com"
   },
   "id": "uptime-watch-2",
   "name": "Ping site",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    520,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const s=$getWorkflowStaticData('global');const up=$json.statusCode?$json.statusCode<400:true;const changed=s.up!==undefined&&s.up!==up;s.up=up;return [{json:{changed,up}}];"
   },
   "id": "uptime-watch-3",
   "name": "Detect change",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    780,
    300
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.changed}}",
       "value2": true
      }
     ]
    }
   },
   "id": "uptime-watch-4",
   "name": "Changed?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Site is {{$json.up?'back up':'DOWN'}}"
   },
   "id": "uptime-watch-5",
   "name": "Telegram",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1300,
    300
   ]
  },
  {
   "parameters": {},
   "id": "uptime-watch-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    560
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "uptime-watch-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    560
   ]
  },
  {
   "parameters": {
    "content": "## Uptime watch\nChecks your sites every 5 minutes and alerts once when one goes down, and once when it recovers.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Keeps state so it alerts on change, not every 5 minutes.\n\nBad or empty input stops the run and alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "uptime-watch-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    20
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Validate input",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Validate input": {
   "main": [
    [
     {
      "node": "Ping site",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Ping site": {
   "main": [
    [
     {
      "node": "Detect change",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Detect change": {
   "main": [
    [
     {
      "node": "Changed?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Changed?": {
   "main": [
    [
     {
      "node": "Telegram",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Ops",
  "description": "Checks your sites every 5 minutes and alerts once when one goes down, and once when it recovers.",
  "guardrails": "Keeps state so it alerts on change, not every 5 minutes."
 }
}
