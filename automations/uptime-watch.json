{
 "name": "Uptime watch",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "*/5 * * * *"
      }
     ]
    }
   },
   "id": "uptime-watch-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "https://REPLACE_ME.example.com"
   },
   "id": "uptime-watch-1",
   "name": "Ping main site",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "https://api.REPLACE_ME.example.com/health"
   },
   "id": "uptime-watch-2",
   "name": "Ping API",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    260,
    200
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "https://docs.REPLACE_ME.example.com"
   },
   "id": "uptime-watch-3",
   "name": "Ping docs",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    260,
    400
   ]
  },
  {
   "parameters": {
    "numberInputs": 3
   },
   "id": "uptime-watch-4",
   "name": "All results",
   "type": "n8n-nodes-base.merge",
   "typeVersion": 3,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const s=$getWorkflowStaticData('global');const down=$input.all().filter(i=>i.json.statusCode>=400).length;const up=down===0;const changed=s.up!==undefined&&s.up!==up;s.up=up;return [{json:{changed,up,down}}];"
   },
   "id": "uptime-watch-5",
   "name": "Detect change",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.changed}}",
       "value2": true
      }
     ]
    }
   },
   "id": "uptime-watch-6",
   "name": "Changed?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Status: {{$json.up?'all back up':$json.down+' endpoint(s) DOWN'}}"
   },
   "id": "uptime-watch-7",
   "name": "Tell me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {},
   "id": "uptime-watch-8",
   "name": "No change",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    1300,
    200
   ]
  },
  {
   "parameters": {},
   "id": "uptime-watch-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    700
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "uptime-watch-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    700
   ]
  },
  {
   "parameters": {
    "content": "## Uptime watch\nPings three endpoints at once every 5 minutes and alerts once when any goes down, and once when it recovers.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Keeps state so it alerts on change, not every 5 minutes.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "uptime-watch-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Ping main site",
      "type": "main",
      "index": 0
     },
     {
      "node": "Ping API",
      "type": "main",
      "index": 0
     },
     {
      "node": "Ping docs",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Ping main site": {
   "main": [
    [
     {
      "node": "All results",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Ping API": {
   "main": [
    [
     {
      "node": "All results",
      "type": "main",
      "index": 1
     }
    ]
   ]
  },
  "Ping docs": {
   "main": [
    [
     {
      "node": "All results",
      "type": "main",
      "index": 2
     }
    ]
   ]
  },
  "All results": {
   "main": [
    [
     {
      "node": "Detect change",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Detect change": {
   "main": [
    [
     {
      "node": "Changed?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Changed?": {
   "main": [
    [
     {
      "node": "Tell me",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "No change",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Ops",
  "description": "Pings three endpoints at once every 5 minutes and alerts once when any goes down, and once when it recovers.",
  "guardrails": "Keeps state so it alerts on change, not every 5 minutes."
 }
}
