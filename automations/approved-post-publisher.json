{
 "name": "Approved post publisher",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "*/30 * * * *"
      }
     ]
    }
   },
   "id": "approved-post-publisher-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "operation": "getAll",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "approved-post-publisher-1",
   "name": "Get approved rows",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.status==='approved'}}",
       "value2": true
      }
     ]
    }
   },
   "id": "approved-post-publisher-2",
   "name": "Approved?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "REPLACE_ME_POSTING_ENDPOINT"
   },
   "id": "approved-post-publisher-3",
   "name": "Publish",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.statusCode<400}}",
       "value2": true
      }
     ]
    }
   },
   "id": "approved-post-publisher-4",
   "name": "Published OK?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "operation": "update",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "approved-post-publisher-5",
   "name": "Mark posted",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Post failed: {{$json.error?.message}}"
   },
   "id": "approved-post-publisher-6",
   "name": "Tell me it failed",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1300,
    200
   ]
  },
  {
   "parameters": {},
   "id": "approved-post-publisher-7",
   "name": "Nothing approved",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    780,
    200
   ]
  },
  {
   "parameters": {},
   "id": "approved-post-publisher-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "approved-post-publisher-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Approved post publisher\nPublishes only rows you marked approved, checks that the post really went out, marks it posted, and alerts you if it did not.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Writes status = posted straight after success to prevent duplicates. A failed post is alerted, never retried blindly.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "approved-post-publisher-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Get approved rows",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Get approved rows": {
   "main": [
    [
     {
      "node": "Approved?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Approved?": {
   "main": [
    [
     {
      "node": "Publish",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Nothing approved",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Publish": {
   "main": [
    [
     {
      "node": "Published OK?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Published OK?": {
   "main": [
    [
     {
      "node": "Mark posted",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Tell me it failed",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Social",
  "description": "Publishes only rows you marked approved, checks that the post really went out, marks it posted, and alerts you if it did not.",
  "guardrails": "Writes status = posted straight after success to prevent duplicates. A failed post is alerted, never retried blindly."
 }
}
