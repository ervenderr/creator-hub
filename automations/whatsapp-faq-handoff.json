    260,
    530
   ]
  },
  {
   "parameters": {
    "content": "## WhatsApp FAQ agent with handoff\nAn AI agent answers from your FAQ with memory of the chat. If the FAQ does not cover it, a person is pinged and the customer is told.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Answers only from the FAQ tool. Uncovered questions are never guessed.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "whatsapp-faq-handoff-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
