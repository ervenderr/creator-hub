{
 "name": "Nightly backup check",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 5 * * *"
      }
     ]
    }
   },
   "id": "nightly-backup-check-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "REPLACE_ME_BACKUP_LIST_URL"
   },
   "id": "nightly-backup-check-1",
   "name": "List backups",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const l=$json.files||[];const last=l.sort((a,b)=>new Date(b.date)-new Date(a.date))[0];const ok=last&&Date.now()-new Date(last.date)<26*36e5&&last.size>1024;return [{json:{ok:!!ok,last:last||null}}];"
   },
   "id": "nightly-backup-check-2",
   "name": "Verify",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{!$json.ok}}",
       "value2": true
      }
     ]
    }
   },
   "id": "nightly-backup-check-3",
   "name": "Problem?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "amount": 10,
    "unit": "minutes"
   },
   "id": "nightly-backup-check-4",
   "name": "Wait 10 minutes",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "REPLACE_ME_BACKUP_LIST_URL"
   },
   "id": "nightly-backup-check-5",
   "name": "List again",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const l=$json.files||[];const last=l.sort((a,b)=>new Date(b.date)-new Date(a.date))[0];const ok=last&&Date.now()-new Date(last.date)<26*36e5&&last.size>1024;return [{json:{ok:!!ok,last:last||null}}];"
   },
   "id": "nightly-backup-check-6",
   "name": "Verify again",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1560,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{!$json.ok}}",
       "value2": true
      }
     ]
    }
   },
   "id": "nightly-backup-check-7",
   "name": "Still a problem?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1820,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Backup problem. Last file: {{JSON.stringify($json.last)}}"
   },
   "id": "nightly-backup-check-8",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    2080,
    0
   ]
  },
  {
   "parameters": {},
   "id": "nightly-backup-check-9",
   "name": "Backup fine",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    1040,
    200
   ]
  },
  {
   "parameters": {},
   "id": "nightly-backup-check-10",
   "name": "Recovered",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    2080,
    200
   ]
  },
  {
   "parameters": {},
   "id": "nightly-backup-check-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "nightly-backup-check-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Nightly backup check\nChecks last night's backup. If it looks wrong it waits 10 minutes and checks again before alerting, to avoid false alarms.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Only checks. It never deletes or restores backups.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "nightly-backup-check-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "List backups",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "List backups": {
   "main": [
    [
     {
      "node": "Verify",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Verify": {
   "main": [
    [
     {
      "node": "Problem?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Problem?": {
   "main": [
    [
     {
      "node": "Wait 10 minutes",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Backup fine",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Wait 10 minutes": {
   "main": [
    [
     {
      "node": "List again",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "List again": {
   "main": [
    [
     {
      "node": "Verify again",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Verify again": {
   "main": [
    [
     {
      "node": "Still a problem?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Still a problem?": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Recovered",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "DevOps",
  "description": "Checks last night's backup. If it looks wrong it waits 10 minutes and checks again before alerting, to avoid false alarms.",
  "guardrails": "Only checks. It never deletes or restores backups."
 }
}
