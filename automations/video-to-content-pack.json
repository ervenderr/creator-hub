{
 "name": "Video to content pack",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 */3 * * *"
      }
     ]
    }
   },
   "id": "video-to-content-pack-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "url": "https://www.youtube.com/feeds/videos.xml?channel_id=REPLACE_ME"
   },
   "id": "video-to-content-pack-1",
   "name": "Read channel feed",
   "type": "n8n-nodes-base.rssFeedRead",
   "typeVersion": 1,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const s=$getWorkflowStaticData('global');s.seen=s.seen||[];const out=$input.all().filter(i=>!s.seen.includes(i.json.link));s.seen=[...s.seen,...out.map(i=>i.json.link)].slice(-200);return out;"
   },
   "id": "video-to-content-pack-2",
   "name": "Only new",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Write one plain post. No hype, no invented facts.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{$json.title+'\\\\n'+$json.contentSnippet}}\"}]}"
   },
   "id": "video-to-content-pack-3",
   "name": "Write post",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Write a 4-part thread. Plain, no invented facts.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{$json.title+'\\\\n'+$json.contentSnippet}}\"}]}"
   },
   "id": "video-to-content-pack-4",
   "name": "Write thread",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Give 5 title ideas under 60 characters.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{$json.title}}\"}]}"
   },
   "id": "video-to-content-pack-5",
   "name": "Title ideas",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    400
   ]
  },
  {
   "parameters": {
    "numberInputs": 3
   },
   "id": "video-to-content-pack-6",
   "name": "Gather drafts",
   "type": "n8n-nodes-base.merge",
   "typeVersion": 3,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "operation": "append",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "video-to-content-pack-7",
   "name": "Queue for review",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {},
   "id": "video-to-content-pack-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    700
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "video-to-content-pack-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    700
   ]
  },
  {
   "parameters": {
    "content": "## Video to content pack\nWhen a new video appears, three drafts are written in parallel (a post, a thread and title ideas) and queued for your review.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Drafts land in a sheet marked 'draft'. Nothing is posted automatically.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "video-to-content-pack-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
