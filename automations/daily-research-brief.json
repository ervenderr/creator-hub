{
 "name": "Daily research brief",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 7 * * *"
      }
     ]
    }
   },
   "id": "daily-research-brief-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    300
   ]
  },
  {
   "parameters": {
    "url": "https://news.ycombinator.com/rss"
   },
   "id": "daily-research-brief-1",
   "name": "Read feed",
   "type": "n8n-nodes-base.rssFeedRead",
   "typeVersion": 1,
   "position": [
    260,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "return [{json:{items:$input.all().slice(0,30).map(i=>({title:i.json.title,link:i.json.link}))}}];"
   },
   "id": "daily-research-brief-2",
   "name": "Collect",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Pick the 5 most useful items for an AI engineer. Reply with JSON only, no prose. Shape: [{\\\"title\\\":\\\"\\\",\\\"link\\\":\\\"\\\",\\\"why\\\":\\\"\\\"}]. Keep links exactly as given.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{JSON.stringify($json.items)}}\"}]}"
   },
   "id": "daily-research-brief-3",
   "name": "Pick five",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    300
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Brief: {{$json.content[0].text}}"
   },
   "id": "daily-research-brief-4",
   "name": "Telegram",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "content": "## Daily research brief\nReads your chosen feeds each morning and sends the five items worth your time, each with its link.\n\n**Setup:** add your credentials to each node, replace every REPLACE_ME, then test with one item before activating.\n\n**Guardrails:** Every item keeps its original link so you can verify. The model picks, it does not rewrite facts.\n\nNo secrets are stored in this file.",
    "height": 200,
    "width": 520
   },
   "id": "daily-research-brief-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    60
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Read feed",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Read feed": {
   "main": [
    [
     {
      "node": "Collect",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Collect": {
   "main": [
    [
     {
      "node": "Pick five",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Pick five": {
   "main": [
    [
     {
      "node": "Telegram",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Research",
  "description": "Reads your chosen feeds each morning and sends the five items worth your time, each with its link.",
  "guardrails": "Every item keeps its original link so you can verify. The model picks, it does not rewrite facts."
 }
}
