{
 "name": "Slack standup collector",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 9 * * 1-5"
      }
     ]
    }
   },
   "id": "slack-standup-collector-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "select": "channel",
    "channelId": {
     "__rl": true,
     "mode": "name",
     "value": "REPLACE_ME_CHANNEL"
    },
    "text": "=Standup: what did you do, what is next, any blockers? Reply in thread."
   },
   "id": "slack-standup-collector-1",
   "name": "Ask questions",
   "type": "n8n-nodes-base.slack",
   "typeVersion": 2.2,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "amount": 120,
    "unit": "minutes"
   },
   "id": "slack-standup-collector-2",
   "name": "Wait 2 hours",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "https://slack.com/api/conversations.replies"
   },
   "id": "slack-standup-collector-3",
   "name": "Read replies",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const r=$input.all().map(i=>i.json.user);return [{json:{replied:r,silent:$('Schedule').first().json.team.filter(u=>!r.includes(u))}}];"
   },
   "id": "slack-standup-collector-4",
   "name": "Who replied",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.silent.length>0}}",
       "value2": true
      }
     ]
    }
   },
   "id": "slack-standup-collector-5",
   "name": "Anyone silent?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {
    "select": "channel",
    "channelId": {
     "__rl": true,
     "mode": "name",
     "value": "REPLACE_ME_CHANNEL"
    },
    "text": "=Reminder: standup reply please."
   },
   "id": "slack-standup-collector-6",
   "name": "Nudge the silent",
   "type": "n8n-nodes-base.slack",
   "typeVersion": 2.2,
   "position": [
    1560,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Summarize by person. Write 'no update' for anyone silent.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{JSON.stringify($json)}}\"}]}"
   },
   "id": "slack-standup-collector-7",
   "name": "Summarize",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1300,
    200
   ]
  },
  {
   "parameters": {
    "select": "channel",
    "channelId": {
     "__rl": true,
     "mode": "name",
     "value": "REPLACE_ME_CHANNEL"
    },
    "text": "={{$json.content[0].text}}"
   },
   "id": "slack-standup-collector-8",
   "name": "Post summary",
   "type": "n8n-nodes-base.slack",
   "typeVersion": 2.2,
   "position": [
    1560,
    200
   ]
  },
  {
   "parameters": {},
   "id": "slack-standup-collector-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "slack-standup-collector-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Slack standup collector\nAsks the team three questions, waits, reads the replies, nudges anyone silent, and posts one combined summary.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Silent people are listed as 'no update', never filled in.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "slack-standup-collector-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Ask questions",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Ask questions": {
   "main": [
    [
     {
      "node": "Wait 2 hours",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Wait 2 hours": {
   "main": [
    [
     {
      "node": "Read replies",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Read replies": {
   "main": [
    [
     {
      "node": "Who replied",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Who replied": {
   "main": [
    [
     {
      "node": "Anyone silent?",
      "type": "main",
      "index": 0
     },
     {
      "node": "Summarize",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Anyone silent?": {
   "main": [
    [
     {
      "node": "Nudge the silent",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Summarize": {
   "main": [
    [
     {
      "node": "Post summary",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Team",
  "description": "Asks the team three questions, waits, reads the replies, nudges anyone silent, and posts one combined summary.",
  "guardrails": "Silent people are listed as 'no update', never filled in."
 }
}
