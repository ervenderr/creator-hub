{
 "name": "Invoice overdue reminder",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 9 * * 1"
      }
     ]
    }
   },
   "id": "invoice-overdue-reminder-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "operation": "getAll",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "invoice-overdue-reminder-1",
   "name": "Read invoices",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "return $input.all().filter(i=>i.json.status==='unpaid'&&new Date(i.json.due)<new Date()).map(i=>({json:{...i.json,days_late:Math.floor((Date.now()-new Date(i.json.due))/864e5)}}));"
   },
   "id": "invoice-overdue-reminder-2",
   "name": "Find overdue",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.days_late>=30}}",
       "value2": true
      }
     ]
    }
   },
   "id": "invoice-overdue-reminder-3",
   "name": "30+ days late?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Invoice {{$json.number}} is {{$json.days_late}} days late."
   },
   "id": "invoice-overdue-reminder-4",
   "name": "Escalate to me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Write a polite 3-line payment reminder. No fees or threats.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{JSON.stringify($json)}}\"}]}"
   },
   "id": "invoice-overdue-reminder-5",
   "name": "Draft reminder",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1040,
    200
   ]
  },
  {
   "parameters": {
    "resource": "draft",
    "operation": "create",
    "subject": "=Reminder: invoice {{$('Find overdue').item.json.number}}",
    "message": "={{$json.content[0].text}}"
   },
   "id": "invoice-overdue-reminder-6",
   "name": "Save draft",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    1300,
    200
   ]
  },
  {
   "parameters": {},
   "id": "invoice-overdue-reminder-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "invoice-overdue-reminder-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Invoice overdue reminder\nFinds unpaid invoices past due. Very late ones (30+ days) escalate to you, the rest get a polite reminder draft.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** Drafts only. It never emails a client on its own and never adds fees or threats.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "invoice-overdue-reminder-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Read invoices",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Read invoices": {
   "main": [
    [
     {
      "node": "Find overdue",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Find overdue": {
   "main": [
    [
     {
      "node": "30+ days late?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "30+ days late?": {
   "main": [
    [
     {
      "node": "Escalate to me",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Draft reminder",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Draft reminder": {
   "main": [
    [
     {
      "node": "Save draft",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Finance",
  "description": "Finds unpaid invoices past due. Very late ones (30+ days) escalate to you, the rest get a polite reminder draft.",
  "guardrails": "Drafts only. It never emails a client on its own and never adds fees or threats."
 }
}
