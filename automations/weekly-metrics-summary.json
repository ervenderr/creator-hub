{
 "name": "Weekly metrics summary",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 9 * * 1"
      }
     ]
    }
   },
   "id": "weekly-metrics-summary-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "operation": "getAll",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "weekly-metrics-summary-1",
   "name": "Read metrics",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    260,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const r=$input.all().map(i=>i.json);const a=r.at(-1),b=r.at(-2)||{};const d=k=>b[k]?Math.round((a[k]-b[k])/b[k]*100):null;return [{json:{this_week:a,change_pct:{views:d('views'),signups:d('signups')}}}];"
   },
   "id": "weekly-metrics-summary-2",
   "name": "Compute change",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Summarize in 3 short lines. Use only the numbers given.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{JSON.stringify($json)}}\"}]}"
   },
   "id": "weekly-metrics-summary-3",
   "name": "Word it",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "https://quickchart.io/chart/create"
   },
   "id": "weekly-metrics-summary-4",
   "name": "Build chart link",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    200
   ]
  },
  {
   "parameters": {
    "numberInputs": 2
   },
   "id": "weekly-metrics-summary-5",
   "name": "Join",
   "type": "n8n-nodes-base.merge",
   "typeVersion": 3,
   "position": [
    1040,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Weekly: {{$json.content[0].text}}"
   },
   "id": "weekly-metrics-summary-6",
   "name": "Send report",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1300,
    0
   ]
  },
  {
   "parameters": {},
   "id": "weekly-metrics-summary-err",
   "name": "On error",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    500
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Automation failed: {{$json.workflow.name}}\n{{$json.execution.error.message}}"
   },
   "id": "weekly-metrics-summary-alert",
   "name": "Alert me",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    260,
    500
   ]
  },
  {
   "parameters": {
    "content": "## Weekly metrics summary\nEvery Monday, computes week-on-week change in code, then writes a summary and builds a chart link at the same time.\n\n**Setup:** add credentials to each node, replace every REPLACE_ME, test with one item, then activate.\n\n**Guardrails:** The math is done in code. The model only words the result and cannot change the numbers.\n\nA failed run alerts you. No secrets are stored in this file.",
    "height": 220,
    "width": 560
   },
   "id": "weekly-metrics-summary-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -320
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Read metrics",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Read metrics": {
   "main": [
    [
     {
      "node": "Compute change",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Compute change": {
   "main": [
    [
     {
      "node": "Word it",
      "type": "main",
      "index": 0
     },
     {
      "node": "Build chart link",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Word it": {
   "main": [
    [
     {
      "node": "Join",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Build chart link": {
   "main": [
    [
     {
      "node": "Join",
      "type": "main",
      "index": 1
     }
    ]
   ]
  },
  "Join": {
   "main": [
    [
     {
      "node": "Send report",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "On error": {
   "main": [
    [
     {
      "node": "Alert me",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Ops",
  "description": "Every Monday, computes week-on-week change in code, then writes a summary and builds a chart link at the same time.",
  "guardrails": "The math is done in code. The model only words the result and cannot change the numbers."
 }
}
