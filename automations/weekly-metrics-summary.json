{
 "name": "Weekly metrics summary",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 9 * * 1"
      }
     ]
    }
   },
   "id": "weekly-metrics-summary-0",
   "name": "Schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    300
   ]
  },
  {
   "parameters": {
    "operation": "getAll",
    "documentId": {
     "__rl": true,
     "mode": "url",
     "value": ""
    },
    "sheetName": {
     "__rl": true,
     "mode": "name",
     "value": "Sheet1"
    }
   },
   "id": "weekly-metrics-summary-1",
   "name": "Read metrics",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    260,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const r=$input.all().map(i=>i.json);const a=r.at(-1),b=r.at(-2)||{};const d=k=>b[k]?Math.round((a[k]-b[k])/b[k]*100):null;return [{json:{this_week:a,change_pct:{views:d('views'),signups:d('signups')}}}];"
   },
   "id": "weekly-metrics-summary-2",
   "name": "Compute",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "anthropic-version",
       "value": "2023-06-01"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"model\": \"claude-haiku-5-5\", \"max_tokens\": 800, \"system\": \"Summarize in 3 short lines. Use only the numbers given.\", \"messages\": [{\"role\": \"user\", \"content\": \"={{JSON.stringify($json)}}\"}]}"
   },
   "id": "weekly-metrics-summary-3",
   "name": "Word it",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    300
   ]
  },
  {
   "parameters": {
    "chatId": "REPLACE_ME_CHAT_ID",
    "text": "=Weekly: {{$json.content[0].text}}"
   },
   "id": "weekly-metrics-summary-4",
   "name": "Telegram",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1040,
    300
   ]
  },
  {
   "parameters": {
    "content": "## Weekly metrics summary\nEvery Monday, reads your tracking sheet, computes the week-on-week change, and sends a short plain-language summary.\n\n**Setup:** add your credentials to each node, replace every REPLACE_ME, then test with one item before activating.\n\n**Guardrails:** The math is done in code. The model only words the result and cannot change the numbers.\n\nNo secrets are stored in this file.",
    "height": 200,
    "width": 520
   },
   "id": "weekly-metrics-summary-note",
   "name": "Read me",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    60
   ]
  }
 ],
 "connections": {
  "Schedule": {
   "main": [
    [
     {
      "node": "Read metrics",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Read metrics": {
   "main": [
    [
     {
      "node": "Compute",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Compute": {
   "main": [
    [
     {
      "node": "Word it",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Word it": {
   "main": [
    [
     {
      "node": "Telegram",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1"
 },
 "meta": {
  "category": "Ops",
  "description": "Every Monday, reads your tracking sheet, computes the week-on-week change, and sends a short plain-language summary.",
  "guardrails": "The math is done in code. The model only words the result and cannot change the numbers."
 }
}
